{
  "name": "@forge/platform-api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/main.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/main.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint src --max-warnings=0",
    "test": "vitest run",
    "test:unit": "vitest run --exclude src/sprint-1e.e2e.test.ts --exclude src/neris.e2e.test.ts --exclude src/neris-incidents.e2e.test.ts --exclude src/imports.e2e.test.ts --exclude src/ai-narrative.acceptance.e2e.test.ts --exclude src/mk-s22-lifecycle.e2e.test.ts --exclude src/testing/**",
    "test:e2e": "vitest run --no-file-parallelism src/sprint-1e.e2e.test.ts src/neris.e2e.test.ts src/mk-s22-lifecycle.e2e.test.ts",
    "test:imports-e2e": "vitest run src/imports.e2e.test.ts",
    "test:platform-e2e": "vitest run src/sprint-1e.e2e.test.ts src/neris.e2e.test.ts src/neris-incidents.e2e.test.ts src/mk-s22-lifecycle.e2e.test.ts",
    "test:neris-e2e": "vitest run src/neris.e2e.test.ts src/neris-incidents.e2e.test.ts",
    "test:neris-incidents-e2e": "vitest run src/neris-incidents.e2e.test.ts",
    "clean": "rimraf dist"
  },
  "dependencies": {
    "@aws-sdk/client-cognito-identity-provider": "^3.1095.0",
    "@aws-sdk/client-kms": "^3.840.0",
    "@aws-sdk/client-s3": "^3.1095.0",
    "@aws-sdk/client-secrets-manager": "^3.1095.0",
    "@aws-sdk/client-sqs": "^3.1095.0",
    "@aws-sdk/s3-request-presigner": "^3.1095.0",
    "@forge/audit": "workspace:*",
    "@forge/auth": "workspace:*",
    "@forge/authorization": "workspace:*",
    "@forge/cad-adapters": "workspace:*",
    "@forge/cad-contracts": "workspace:*",
    "@forge/cad-core": "workspace:*",
    "@forge/cad-simulator": "workspace:*",
    "@forge/ai": "workspace:*",
    "@forge/ai-contracts": "workspace:*",
    "@forge/ai-observability": "workspace:*",
    "@forge/contracts": "workspace:*",
    "@forge/configuration": "workspace:*",
    "@forge/database": "workspace:*",
    "@forge/environment": "workspace:*",
    "@forge/errors": "workspace:*",
    "@forge/events": "workspace:*",
    "@forge/imports": "workspace:*",
    "@forge/neris": "workspace:*",
    "@forge/observability": "workspace:*",
    "@forge/security": "workspace:*",
    "@forge/tenant-context": "workspace:*",
    "@forge/validation": "workspace:*",
    "@nestjs/common": "^11.1.3",
    "@nestjs/core": "^11.1.3",
    "@nestjs/platform-express": "^11.1.3",
    "drizzle-orm": "^0.44.2",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "zod": "^3.25.67"
  },
  "devDependencies": {
    "@nestjs/testing": "^11.1.3",
    "@swc/core": "^1.15.46",
    "@types/express": "^5.0.3",
    "@types/supertest": "^6.0.3",
    "rimraf": "^6.0.1",
    "supertest": "^7.1.1",
    "tsx": "^4.20.3",
    "typescript": "^5.8.3",
    "unplugin-swc": "^1.5.9",
    "vitest": "^3.2.4"
  }
}
