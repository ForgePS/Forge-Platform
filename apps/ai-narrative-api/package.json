{
  "name": "@forge/ai-narrative-api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Shared Forge AI Narrative Assistant service entrypoint. Foundation HTTP routes mount via platform-api until dedicated ECS is authorized.",
  "scripts": {
    "dev": "tsx watch src/main.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/main.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run --passWithNoTests",
    "test:unit": "vitest run --passWithNoTests",
    "clean": "rimraf dist"
  },
  "dependencies": {
    "@forge/ai": "workspace:*",
    "@forge/ai-contracts": "workspace:*",
    "@forge/ai-observability": "workspace:*",
    "@forge/environment": "workspace:*",
    "@forge/observability": "workspace:*",
    "@nestjs/common": "^11.1.29",
    "@nestjs/core": "^11.1.29",
    "@nestjs/platform-express": "^11.1.29",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2"
  },
  "devDependencies": {
    "rimraf": "^6.0.1",
    "tsx": "^4.20.3",
    "typescript": "^5.8.3",
    "vitest": "^3.2.4"
  }
}
