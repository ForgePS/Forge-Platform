{
  "name": "forge-platform",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Forge Public Safety AWS platform monorepo",
  "packageManager": "pnpm@10.12.1",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "test:unit": "turbo run test:unit",
    "test:integration": "turbo run test:integration",
    "test:e2e": "turbo run test:e2e",
    "test:e2e:rms": "pnpm --filter @forge/rms-web-e2e test:e2e",
    "test:rls": "turbo run test:rls",
    "test:platform-e2e": "turbo run test:platform-e2e",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "clean": "turbo run clean",
    "generate": "turbo run generate",
    "infra:synth": "turbo run infra:synth",
    "infra:validate": "pnpm --filter @forge/infrastructure-cdk run validate",
    "infra:test": "pnpm --filter @forge/infrastructure-cdk run test",
    "infra:nag": "pnpm --filter @forge/infrastructure-cdk run nag",
    "infra:diff": "pnpm --filter @forge/infrastructure-cdk run diff",
    "infra:bootstrap": "pnpm --filter @forge/infrastructure-cdk run bootstrap",
    "infra:deploy": "pnpm --filter @forge/infrastructure-cdk run deploy",
    "infra:destroy": "pnpm --filter @forge/infrastructure-cdk run destroy",
    "smoke:development": "node scripts/smoke-development.mjs",
    "deploy:console": "node scripts/sync-static-site.mjs --app console",
      "deploy:rms-web": "node scripts/sync-static-site.mjs --app rms",
      "deploy:industrial-web": "node scripts/sync-static-site.mjs --app industrial",
    "deploy:tenant-admin": "node scripts/sync-static-site.mjs --app tenantadmin",
    "db:up": "docker compose up -d postgres",
    "db:down": "docker compose down",
    "db:reset": "docker compose down -v && docker compose up -d postgres",
    "db:logs": "docker compose logs -f postgres",
    "db:test:reset": "pnpm --filter @forge/database db:test:reset",
    "db:migrate": "pnpm --filter @forge/database db:migrate",
    "db:migrate:status": "pnpm --filter @forge/database db:migrate:status",
    "db:migrate:development": "pnpm --filter @forge/database db:migrate",
    "db:migrate:test": "pnpm --filter @forge/database db:migrate:test",
    "db:generate": "pnpm --filter @forge/database db:generate",
    "db:seed": "pnpm --filter @forge/database db:seed",
    "neris:seed-rms": "pnpm --filter @forge/database neris:seed-rms",
    "neris:classify-warnings": "node scripts/neris-classify-phase1-warnings.mjs",
    "platform:bootstrap-admin": "tsx scripts/bootstrap-admin.ts",
    "platform:onboard-tenant": "tsx scripts/onboard-tenant.ts",
    "neris:import-schema": "pnpm --filter @forge/database neris:import-schema",
    "worker:enable:development": "node scripts/worker-scale.mjs enable development",
    "worker:disable:development": "node scripts/worker-scale.mjs disable development",
    "audit:deps": "pnpm audit --prod"
  },
  "devDependencies": {
    "@eslint/js": "^9.29.0",
    "@types/node": "^22.15.32",
    "eslint": "^9.29.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "globals": "^16.2.0",
    "prettier": "^3.5.3",
    "tsx": "^4.20.3",
    "turbo": "^2.5.4",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.34.1",
    "vitest": "^3.2.4"
  }
}
